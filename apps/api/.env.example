# --- App ---
# development | test | production. Defaults to "development" if unset.
NODE_ENV=development
# Port the HTTP server listens on. Defaults to 3000 if unset.
PORT=3000

# --- CORS ---
# Comma-separated list of allowed origins. Required — the app fails to boot
# without it. Never "*" together with credentials.
CORS_ORIGINS=http://localhost:5173

# --- Auth (placeholder — not wired yet, but validated at boot so a weak/missing
# secret can't slip in once the auth module lands) ---
# Min 32 chars. Required.
JWT_SECRET=replace-with-a-random-string-min-32-chars
# Access token lifetime. Defaults to "15m" if unset.
JWT_EXPIRES_IN=15m
# Min 32 chars, must differ from JWT_SECRET. Required.
JWT_REFRESH_SECRET=replace-with-a-different-random-string-min-32-chars
# Refresh token lifetime. Defaults to "7d" if unset.
JWT_REFRESH_EXPIRES_IN=7d

# --- Database (placeholder — DatabaseModule is still a no-op) ---
# Optional until an ORM (Prisma/TypeORM) is wired in database.module.ts.
DATABASE_URL=postgresql://user:password@localhost:5432/ultimatecanvas
