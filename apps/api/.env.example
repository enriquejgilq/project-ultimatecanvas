# --- App ---
# development | test | production. Defaults to "development" if unset.
NODE_ENV=development
# Port the HTTP server listens on. Defaults to 3000 if unset.
PORT=3000

# --- CORS ---
# Comma-separated list of allowed origins. Required — the app fails to boot
# without it. Never "*" together with credentials.
CORS_ORIGINS=http://localhost:5173

# --- Auth ---
# Signs the short-lived access token (sessions are opaque, revocable DB tokens
# stored in an HttpOnly cookie). Min 32 chars. Required.
JWT_SECRET=replace-with-a-random-string-min-32-chars
# Access token lifetime. Defaults to "15m" if unset.
JWT_EXPIRES_IN=15m

# --- Database ---
# Postgres connection string used by Prisma (PrismaService). Required.
DATABASE_URL=postgresql://user:password@localhost:5432/ultimatecanvas

# --- Auth emails ---
# Base URL of the web app, used to build the links sent by email. Required.
APP_WEB_URL=http://localhost:5173
# "console" logs emails (with their links) to the API log — dev/test only, rejected
# when NODE_ENV=production. "smtp" sends them through SMTP_URL.
MAIL_TRANSPORT=console
# Required when MAIL_TRANSPORT=smtp. Local Mailpit: smtp://localhost:1025
# SMTP_URL=smtp://localhost:1025
# Sender shown in every email. Required.
MAIL_FROM="UltimateCanvas <no-reply@localhost>"

# --- Proxy ---
# true when running behind a reverse proxy (e.g. the web container's nginx), so
# throttling and security events use the real client IP. Defaults to false.
TRUST_PROXY=false
