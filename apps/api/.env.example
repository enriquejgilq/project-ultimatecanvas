# --- App ---
NODE_ENV=development
PORT=3000

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# --- Auth (placeholder — not wired yet) ---
JWT_SECRET=replace-with-a-random-string-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-string-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# --- Database (placeholder — not wired yet) ---
DATABASE_URL=postgresql://user:password@localhost:5432/ultimatecanvas
