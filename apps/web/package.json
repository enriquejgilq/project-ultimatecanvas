  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@ucanvas/shared": "workspace:*",
    "@ucanvas/ui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@ucanvas/eslint-config": "workspace:*",
    "@ucanvas/tsconfig": "workspace:*",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.15.0",
    "jsdom": "^25",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
