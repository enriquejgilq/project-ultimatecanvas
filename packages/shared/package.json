{
  "name": "@ucanvas/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "dev": "node scripts/mark-cjs.mjs && (tsc -p tsconfig.json --watch & tsc -p tsconfig.cjs.json --watch)",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no tests yet\""
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ucanvas/eslint-config": "workspace:*",
    "@ucanvas/tsconfig": "workspace:*",
    "eslint": "^9.15.0",
    "typescript": "^5.6.3"
  },
  "module": "./dist/index.js"
}
